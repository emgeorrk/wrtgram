# wrtgram - Telegram bot for OpenWrt
# Reference: https://github.com/emgeorrk/wrtgram#configuration
# Keep this file private (chmod 600): it holds the bot token.

config main 'main'
	option enabled '1'
	option token ''                 # bot token from @BotFather (or run: wrtgram setup)
	# list chat_id '123456789'      # chats allowed to talk to the bot; empty = the bot replies with your chat id
	# list notify_chat_id ''        # where notifications go (default: chat_id)
	option proxy ''                 # http://..., socks5h://host:1080 or empty
	option log_level 'info'         # debug | info | warn | error
	option workers '2'
	option wan_interface ''         # empty = detect automatically

# Modules are enabled by default and skip themselves when the router lacks
# the required tools. Disable one with `option enabled '0'`.

config module 'devices'
	option page_size '25'

config module 'failover'
	option enabled '0'              # set to 1 and list the tunnels (first = primary)
	# list tunnel 'wg0'
	# list tunnel 'wg1'
	# list target '1.1.1.1'         # ping targets (default: 1.1.1.1 8.8.8.8 9.9.9.9)
	option grace '300'              # seconds the primary may be down before switching
	option interval '30'            # seconds between checks
	option ntp_direct '1'           # keep the router's NTP on the WAN gateway (needs ip-full)
	# list service_net '…'          # networks always routed via a live tunnel (default: Telegram)

config module 'backup'
	option password ''              # empty = unencrypted archives (not recommended)

config module 'services'
	# list service 'adblock'        # services /restart may restart

# config command 'speed'          # custom shell commands become /speed
#	option command '/usr/bin/speedtest-cli --simple'
#	option description 'Run a speed test'
#	option timeout '90'
#	option confirm '0'

# Notifications (all enabled by default).

config notify 'boot'
	option enabled '1'

config notify 'new_device'
	option enabled '1'

config notify 'logins'
	option enabled '1'
	option success_window '3600'    # one success per IP per hour
	option failure_window '600'     # one failure per IP per 10 minutes
	# list trusted_ip '192.168.1.10'

config notify 'thermal'
	option enabled '1'
	option high '85'
	option normal '75'
	option interval '60'
	option remind '3600'

config notify 'backup'
	option enabled '1'
	option day 'sun'
	option time '03:30'

config notify 'failover'
	option enabled '1'
