# wrtgram - Telegram bot for OpenWrt
# Full reference: https://github.com/emgeorrk/wrtgram#configuration
# Keep this file private (chmod 600): it holds the bot token.

config main 'main'
	option enabled '1'
	option token ''                 # bot token from @BotFather
	# list chat_id '123456789'      # chats allowed to talk to the bot; empty = the bot replies with your chat id
	# list notify_chat_id ''        # where notifications go (default: chat_id)
	option proxy ''                 # http://..., socks5h://host:1080 or empty
	option log_level 'info'         # debug | info | warn | error
	option workers '2'
	option wan_interface ''         # empty = detect automatically

# Modules are enabled by default and skipped automatically when the router
# lacks the required tools. Disable one with `option enabled '0'`.

config module 'system'
	option enabled '1'

config module 'network'
	option enabled '1'

config module 'thermal'
	option enabled '1'

config notify 'boot'
	option enabled '1'
