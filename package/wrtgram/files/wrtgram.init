#!/bin/sh /etc/rc.common
# wrtgram - Telegram bot for OpenWrt

USE_PROCD=1
START=99
STOP=10

PROG=/usr/bin/wrtgram

start_service() {
	local enabled
	config_load wrtgram
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0

	procd_open_instance
	procd_set_param command "$PROG" run
	# Keep the Go runtime frugal on small routers.
	procd_set_param env GOGC=50 GOMEMLIMIT=32MiB
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 10
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger wrtgram
}

reload_service() {
	restart
}
